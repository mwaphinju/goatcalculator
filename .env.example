# Copy this file to .env.local for local development. The project runs
# fully without any of these being set — there are no required secrets and
# no external service credentials.

# Canonical origin used for metadata (e.g. absolute URLs, canonical links).
# Leave unset locally; set this in the deployment environment once a real
# domain (custom domain or the Render-assigned URL) is known. Do not invent
# a URL here — an unset value falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://example.com
