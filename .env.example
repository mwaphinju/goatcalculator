# Copy this file to .env.local for local development. The project runs
# fully without any of these being set — there are no required secrets and
# no external service credentials.

# Canonical origin used for metadata: canonical links, sitemap.xml,
# robots.txt's Sitemap line, Open Graph URLs, and structured data URLs.
# Leave unset locally; an unset value falls back to http://localhost:3000,
# which is a safe value to build with and is never mistaken for a real,
# live domain. Must be an absolute https URL in production (a localhost
# URL is also accepted, for local testing). No trailing slash.
#
# Phase 6 (deployment) must set this to the final Render URL or custom
# domain before deploying — see docs/SEO_LAUNCH_CHECKLIST.md.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
